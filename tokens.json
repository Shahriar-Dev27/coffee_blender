{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Expressive cafe editorial design with warm cream, oxblood red, tactile ceramic, and a continuous Three.js cup-to-order journey.",
  "color": {
    "$type": "color",
    "primary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.549,
          0.184,
          0.224
        ],
        "hex": "#8c2f39"
      }
    },
    "primaryHover": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.439,
          0.137,
          0.173
        ],
        "hex": "#70232c"
      }
    },
    "neutral": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.969,
          0.945,
          0.91
        ],
        "hex": "#f7f1e8"
      }
    },
    "surface": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          0.976,
          0.945
        ],
        "hex": "#fff9f1"
      }
    },
    "ink": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.161,
          0.133,
          0.122
        ],
        "hex": "#29221f"
      }
    },
    "muted": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.443,
          0.392,
          0.357
        ],
        "hex": "#71645b"
      }
    },
    "secondary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.847,
          0.878,
          0.757
        ],
        "hex": "#d8e0c1"
      }
    },
    "tertiary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.945,
          0.835,
          0.541
        ],
        "hex": "#f1d58a"
      }
    },
    "border": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.843,
          0.788,
          0.733
        ],
        "hex": "#d7c9bb"
      }
    },
    "controlBorder": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.537,
          0.467,
          0.416
        ],
        "hex": "#89776a"
      }
    },
    "focus": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.282,
          0.376,
          0.243
        ],
        "hex": "#48603e"
      }
    },
    "danger": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.631,
          0.149,
          0.133
        ],
        "hex": "#a12622"
      }
    }
  },
  "spacing": {
    "$type": "dimension",
    "xs": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "sm": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "xl": {
      "$value": {
        "value": 32,
        "unit": "px"
      }
    },
    "xxl": {
      "$value": {
        "value": 48,
        "unit": "px"
      }
    },
    "section": {
      "$value": {
        "value": 96,
        "unit": "px"
      }
    }
  },
  "rounded": {
    "$type": "dimension",
    "flat": {
      "$value": {
        "value": 0,
        "unit": "px"
      }
    },
    "control": {
      "$value": {
        "value": 6,
        "unit": "px"
      }
    },
    "panel": {
      "$value": {
        "value": 12,
        "unit": "px"
      }
    },
    "circle": {
      "$value": {
        "value": 999,
        "unit": "px"
      }
    }
  },
  "typography": {
    "hero": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Bricolage Grotesque",
        "fontSize": {
          "value": 12,
          "unit": "rem"
        },
        "fontWeight": 800,
        "letterSpacing": {
          "value": -0.055,
          "unit": "em"
        }
      }
    },
    "h1": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Bricolage Grotesque",
        "fontSize": {
          "value": 7.5,
          "unit": "rem"
        },
        "fontWeight": 700,
        "letterSpacing": {
          "value": -0.04,
          "unit": "em"
        }
      }
    },
    "h2": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Bricolage Grotesque",
        "fontSize": {
          "value": 4.5,
          "unit": "rem"
        },
        "fontWeight": 700,
        "letterSpacing": {
          "value": -0.035,
          "unit": "em"
        }
      }
    },
    "body-md": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Instrument Sans",
        "fontSize": {
          "value": 1,
          "unit": "rem"
        },
        "fontWeight": 400,
        "letterSpacing": {
          "value": 0,
          "unit": "em"
        }
      }
    },
    "body-lg": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Instrument Sans",
        "fontSize": {
          "value": 1.25,
          "unit": "rem"
        },
        "fontWeight": 400
      }
    },
    "label": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Instrument Sans",
        "fontSize": {
          "value": 0.875,
          "unit": "rem"
        },
        "fontWeight": 500
      }
    },
    "control": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Instrument Sans",
        "fontSize": {
          "value": 1,
          "unit": "rem"
        },
        "fontWeight": 600
      }
    }
  }
}
